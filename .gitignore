# Ignore Python cache folders
__pycache__/

# Ignore distribution folder
build/

# Ignore PyInstaller files
*.spec

# Ignore Google Drive Desktop files
desktop.ini

# Ignore mods files while keeping its folders
/mods/**
!/mods/**/
!/mods/**/.gitkeep

# Keep mod configuration files
!/mods/*/seamless-coop/*rsc_settings.ini
!/mods/*/unlock-fps/UnlockTheFps/config.ini
